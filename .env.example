# 环境变量示例 —— 复制为 .env 后填写真实值
#   cp .env.example .env
# ⚠ .env 含密钥，已在 .gitignore / .dockerignore 中排除，不要提交

# ── 阿里云百炼（DashScope）────────────────────────────────────────────
# server.py 的 API Key 来源之一（也可用 --key / key.txt）
DASHSCOPE_API_KEY=sk-ws-your-key-here

# ── 模型 / 音色 ──────────────────────────────────────────────────────
# 实测可用：
#   qwen-audio-3.1-realtime-plus   ← 默认：首响更快、更自然
#   qwen-audio-3.0-realtime-plus
#   qwen-audio-3.0-realtime-flash
PET_MODEL=qwen-audio-3.1-realtime-plus
# 内置音色（实测支持）：longanqian / longanlingxin / longanlingxi / longanxiaoxin / longanlufeng
QWEN_VOICE=longanqian

# ── 公司知识库（KB）代理（可选）─────────────────────────────────────
# 中继把 GET /kb 代理到这里；连不上不影响语音对话，模型会答"暂时查不到"
# ⚠ API 端口是 13000（80 端口是另一套 nginx 前端，不是 API）
PET_KB_BASE=http://192.168.5.196:13000
PET_KB_USER=17427833417981666
PET_KB_TIMEOUT=30

# ── HTTPS / 局域网（可选）───────────────────────────────────────────
# PET_TLS_PORT=8772
# Docker 下探测不到宿主机局域网 IP，需手动指定证书额外 SAN
# PET_TLS_EXTRA_SAN=192.168.5.91
